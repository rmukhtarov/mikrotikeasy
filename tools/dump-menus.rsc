:local paths [:toarray "interface,interface.bridge,interface.bridge.port,interface.bridge.vlan,interface.bridge.settings,interface.bridge.filter,interface.vlan,interface.list,interface.list.member,interface.wireguard,interface.wireguard.peers,interface.ethernet,interface.ethernet.switch,interface.bonding,interface.pppoe-client,interface.pppoe-server.server,interface.l2tp-server.server,interface.sstp-server.server,interface.ovpn-server.server,interface.eoip,interface.gre,interface.vxlan,interface.vrrp,interface.veth,interface.wifi,interface.wireless,interface.lte,interface.detect-internet,ip.address,ip.route,ip.pool,ip.dhcp-server,ip.dhcp-server.network,ip.dhcp-server.lease,ip.dhcp-server.option,ip.dhcp-client,ip.dhcp-relay,ip.dns,ip.dns.static,ip.firewall.filter,ip.firewall.nat,ip.firewall.mangle,ip.firewall.raw,ip.firewall.address-list,ip.firewall.connection.tracking,ip.firewall.service-port,ip.service,ip.neighbor.discovery-settings,ip.settings,ip.cloud,ip.hotspot,ip.hotspot.profile,ip.hotspot.user,ip.hotspot.user.profile,ip.hotspot.walled-garden,ip.proxy,ip.socks,ip.upnp,ip.upnp.interfaces,ip.ssh,ip.traffic-flow,ip.arp,ip.ipsec.peer,ip.ipsec.identity,ip.ipsec.policy,ip.ipsec.profile,ip.ipsec.proposal,ip.vrf,ppp.profile,ppp.secret,ppp.aaa,radius,radius.incoming,queue.simple,queue.tree,queue.type,routing.table,routing.rule,routing.filter.rule,routing.ospf.instance,routing.ospf.area,routing.ospf.interface-template,routing.bgp.connection,routing.bgp.template,system.identity,system.clock,system.ntp.client,system.ntp.client.servers,system.ntp.server,system.logging,system.logging.action,system.scheduler,system.script,system.note,system.watchdog,tool.mac-server,tool.mac-server.mac-winbox,tool.mac-server.ping,tool.romon,tool.bandwidth-server,tool.netwatch,tool.graphing.interface,tool.e-mail,snmp,snmp.community,user,user.group,user.settings,certificate,ipv6.address,ipv6.route,ipv6.firewall.filter,ipv6.firewall.address-list,ipv6.settings,ipv6.nd,ipv6.dhcp-client,ipv6.dhcp-server,ipv6.pool,disk,file"]; :foreach p in=$paths do={ :local pp [:toarray ""]; :foreach x in=[:toarray [:pick $p 0 [:len $p]]] do={}; :local path ""; :for i from=0 to=([:len $p]-1) do={:local c [:pick $p $i]; :if ($c=".") do={:set path ($path . ",")} else={:set path ($path . $c)}}; :do { :foreach c in=[/console inspect as-value request=child path=$path] do={ :if (($c->"type")="child" && ($c->"node-type")="cmd") do={ :local cmd ($c->"name"); :if ($cmd="add" || $cmd="set" || $cmd="remove" || $cmd="print" || $cmd="enable" || $cmd="disable" || $cmd="reset-counters") do={ :local args ""; :if ($cmd="add" || $cmd="set") do={ :do { :foreach a in=[/console inspect as-value request=child path=($path . "," . $cmd)] do={ :if (($a->"type")="child" && ($a->"node-type")="arg") do={ :set args ($args . ($a->"name") . " ") } } } on-error={} }; :put ("C|" . $path . "|" . $cmd . "|" . $args) } } } } on-error={ :put ("X|" . $path) } }
