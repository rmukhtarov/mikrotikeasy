# MikrotikEasy settings. Copy to .env (install.sh does this for you).

# ---------------------------------------------------------------------------
# AI assistant (optional)
# Easiest: open Settings (gear icon) in the app. Values saved there override this file;
# this file stays as the fallback ("Back to .env" in Settings returns to it).
# The Master (setup wizard) never needs an LLM. The AI tab turns a free-text
# description into a script and reviews a pasted /export.
#   AI_ENABLED=true   AI tab on (needs the LLM_* settings below)
#   AI_ENABLED=false  plain configurator: no AI tab, no AI wording, no LLM calls
#   empty             on when LLM_BASE_URL is set, otherwise off
# ---------------------------------------------------------------------------
AI_ENABLED=

# Example 1: LocalAI on your LAN (OpenAI-compatible API)
# LLM_BASE_URL=http://localai.lan:8080/v1
# LLM_API_KEY=sk-your-localai-key
# LLM_MODEL=qwen3-coder-30b-a3b-instruct

# Example 2: Ollama
# LLM_BASE_URL=http://ollama.lan:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen2.5-coder:14b

# Example 3: any hosted OpenAI-compatible endpoint
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=your-api-key
# LLM_MODEL=model-name

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=300000
# Qwen3-style "thinking" models: keep thinking off, or one request can run for minutes
LLM_THINKING=false
FIX_ROUNDS=2

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
# Optional: encryption secret for the API key saved from Settings (default: a random file in the data folder)
# SETTINGS_SECRET=
# Image tag to run (see GitHub releases)
MIKROTIKEASY_TAG=1.2.0
APP_PORT=3090
TZ=Asia/Baku
# Where the AI mistake memory is kept on the host (default /home/$USER/docker/mikrotikeasy/data)
# DATA_DIR=/srv/mikrotikeasy/data
# Change if 192.168.62.0/24 is already used on the host
# NET_SUBNET=192.168.62.0/24
# NET_GATEWAY=192.168.62.1
